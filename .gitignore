# --- Secrets ---
.env

# --- Python / build artifacts ---
__pycache__/
*.pyc
.venv/
.pytest_cache/
build/
*.egg-info/
.ipynb_checkpoints/
.DS_Store

# --- Trained model artifacts (regenerable) ---
models/*.pkl
models/*.json
models/artifacts/

# --- Early-warning run directories (summaries are copied to reports/results/) ---
runs/

# --- Local copies of trained artifacts. The write-ups in reports/ are the durable record. ---
reports/paper_snapshot/

# --- Data: ignore everything except the canonical engineered matrix ---
data/raw/
data/processed/
data/features/*
!data/features/.gitkeep
!data/features/feature_matrix_engineered_v2.parquet

# --- Notebooks intentionally excluded from the public repo ---
# (data construction, diagnostics, TimesFM hybrid, retrieval experiment)
notebooks/data_inspection.ipynb
notebooks/build_raw_matrix.ipynb
notebooks/build_engineered_matrix.ipynb
notebooks/residual_diagnostics.ipynb
notebooks/timesfm_xgboost.ipynb
notebooks/feature_diagnostics.ipynb
notebooks/rag_forecaster.ipynb
